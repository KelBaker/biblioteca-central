# Copie este arquivo para ".env" e preencha com seus valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# String de conexão do MongoDB. Em desenvolvimento local, pode deixar em branco
# para usar o MongoDB local padrão. Em produção, use a connection string do
# MongoDB Atlas (Cluster > Connect > Drivers).
MONGO_URI=mongodb://localhost:27017/livros

# Porta em que o servidor Express vai rodar. A maioria dos serviços de
# hospedagem (Render, Railway, etc.) já define essa variável automaticamente.
PORT=3000

# URL do front-end publicado, para restringir o CORS em produção.
# Deixe em branco em desenvolvimento local.
CORS_ORIGIN=
